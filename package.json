{
  "name": "kanbalone",
  "version": "0.9.35",
  "description": "Kanbalone: ultra-light local personal kanban for human and AI collaboration",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm lint:openapi",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "docs:build": "node scripts/build-pages.mjs",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm check:public && pnpm docs:build",
    "check:public": "tsc -p tsconfig.public.json",
    "sandbox:remote-providers": "node scripts/bootstrap-remote-providers.mjs",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test",
    "perf:seed": "node scripts/perf-seed.mjs",
    "perf:benchmark": "node scripts/perf-benchmark.mjs"
  },
  "keywords": [
    "kanbalone",
    "kanban",
    "fastify",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.82.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "volta": {
    "node": "26.13.1"
  }
}
