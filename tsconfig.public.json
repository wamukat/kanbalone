{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "public/app-api.js",
    "public/app-card-tooltips.js",
    "public/app-board-utils.js",
    "public/app-dialogs.js",
    "public/app-preferences.js",
    "public/app-priority.js",
    "public/app-remote-provider.js",
    "public/app-tags.js",
    "public/app-group-*.js",
    "public/app-ticket-sort.js",
    "public/app-ticket-tasks.js",
    "public/app-ticket-hierarchy.js",
    "public/app-ticket-inline-icons.js",
    "public/app-ticket-pages.js",
    "public/app-ticket-collections.js"
  ]
}
